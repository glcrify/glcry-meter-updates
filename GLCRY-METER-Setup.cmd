function Step($n, $t) { Write-Host ''; Write-Host "   $n/7  " -ForegroundColor Yellow -NoNewline; Write-Host $t -ForegroundColor White }
function Ok($t) { Write-Host "        OK  $t" -ForegroundColor Green }
function Note($t) { Write-Host "        $t" -ForegroundColor Gray }
function Download($url, $out) {
    Note "Downloading $([IO.Path]::GetFileName($out))..."
    for ($i = 1; $i -le 3; $i++) {
        try { Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $out -Headers @{ 'User-Agent' = 'GLCRYMETER-Setup' }; return }
        catch { if ($i -eq 3) { throw "Couldn't download $url - check your internet connection." }; Start-Sleep 2 }
    }
}
function LatestAsset($repo, $pattern) {
    $r = Invoke-RestMethod -UseBasicParsing -Uri "https://api.github.com/repos/$repo/releases/latest" -Headers @{ 'User-Agent' = 'GLCRYMETER-Setup' }
    $a = $r.assets | Where-Object { $_.name -match $pattern } | Select-Object -First 1
    if (-not $a) { $a = $r.assets | Where-Object { $_.name -match '\.(exe|msi)$' } | Select-Object -First 1 }
    if (-not $a) { throw "No installer found for $repo" }
    return $a.browser_download_url
}
function Native {
    # Run an external program; its warnings on stderr must not abort setup.
    $old = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try { & $args[0] $args[1..($args.Count - 1)] | Out-Host } finally { $ErrorActionPreference = $old }
    return $LASTEXITCODE
}
function InstallPython($Py, $Tmp) {
    # 1) normal installer (with a log). 2) if it refuses - usually because this
    # Python version is already on the PC - unpack the official no-installer
    # package from nuget.org instead, which never conflicts with anything.
    New-Item -ItemType Directory -Force -Path $Tmp | Out-Null
    $exe = Join-Path $Tmp 'python-setup.exe'
    $log = Join-Path $Tmp 'python-install.log'
    try {
        Invoke-WebRequest -UseBasicParsing -Uri 'https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe' -OutFile $exe
        $null = Start-Process $exe -ArgumentList "/quiet InstallAllUsers=0 TargetDir=`"$Py`" Include_launcher=0 PrependPath=0 Shortcuts=0 Include_test=0 Include_doc=0 AssociateFiles=0 /log `"$log`"" -Wait -PassThru
    } catch { }
    if (Test-Path (Join-Path $Py 'pythonw.exe')) { return }
    Write-Host '        Trying another way...' -ForegroundColor Gray
    $pkg = Join-Path $Tmp 'python-nuget.zip'
    $x = Join-Path $Tmp 'python-nuget'
    Invoke-WebRequest -UseBasicParsing -Uri 'https://www.nuget.org/api/v2/package/python/3.11.9' -OutFile $pkg
    if (Test-Path $x) { Remove-Item -Recurse -Force $x }
    Expand-Archive -Path $pkg -DestinationPath $x -Force
    New-Item -ItemType Directory -Force -Path $Py | Out-Null
    Copy-Item -Path (Join-Path $x 'tools\*') -Destination $Py -Recurse -Force
    if (-not (Test-Path (Join-Path $Py 'python.exe'))) { throw "Python did not install (log: $log)" }
    if (-not (Test-Path (Join-Path $Py 'pythonw.exe'))) { Copy-Item (Join-Path $Py 'python.exe') (Join-Path $Py 'pythonw.exe') }
    $null = Native (Join-Path $Py 'python.exe') -m ensurepip --upgrade --default-pip
}
function RunInstaller($file) {
    if ($file -match '\.msi$') { $p = Start-Process msiexec.exe -ArgumentList "/i `"$file`" /qn /norestart" -Wait -PassThru }
    else { $p = Start-Process $file -ArgumentList '/quiet /norestart' -Wait -PassThru }
    return $p.ExitCode
}

$ObsExe = Join-Path $env:ProgramFiles 'obs-studio\bin\64bit\obs64.exe'
function InstallObs($Tmp) {
    # 1) winget (built into Windows 10/11), 2) the official installer from GitHub
    $wg = Get-Command winget -ErrorAction SilentlyContinue
    if ($wg) {
        $null = Native $wg.Source install --id OBSProject.OBSStudio -e --silent --accept-package-agreements --accept-source-agreements --disable-interactivity
        if (Test-Path $ObsExe) { return }
    }
    $r = Invoke-RestMethod -UseBasicParsing -Uri 'https://api.github.com/repos/obsproject/obs-studio/releases/latest' -Headers @{ 'User-Agent' = 'GLCRYMETER-Setup' }
    $a = $r.assets | Where-Object { $_.name -match '\.exe$' -and $_.name -match 'Installer' -and $_.name -notmatch 'arm' } | Select-Object -First 1
    if (-not $a) { throw 'No OBS installer found' }
    $f = Join-Path $Tmp 'OBS_setup.exe'
    Download $a.browser_download_url $f
    $null = Start-Process $f -ArgumentList '/S' -Wait -PassThru
}
function ConfigureObs {
    # Only for a fresh OBS (no scene collections yet): a ready-made GLCRY METER
    # setup - 1920x1080 at 240 fps, a Game Capture of NBA 2K21, no first-run wizard.
    $cfg = Join-Path $env:APPDATA 'obs-studio'
    $scenes = Join-Path $cfg 'basic\scenes'
    if (Get-ChildItem -Path $scenes -Filter *.json -ErrorAction SilentlyContinue | Select-Object -First 1) { return $false }
    $prof = Join-Path $cfg 'basic\profiles\GLCRY_METER'
    New-Item -ItemType Directory -Force -Path $scenes, $prof | Out-Null
    $enc = New-Object System.Text.UTF8Encoding($false)
    $ini = "[General]`r`nFirstRun=true`r`nLastVersion=0`r`n`r`n[Basic]`r`nProfile=GLCRY METER`r`nProfileDir=GLCRY_METER`r`nSceneCollection=GLCRY METER`r`nSceneCollectionFile=GLCRY_METER`r`n"
    foreach ($n in 'global.ini', 'user.ini') {
        $f = Join-Path $cfg $n
        if (-not (Test-Path $f)) { [IO.File]::WriteAllText($f, $ini, $enc) }
    }
    $basic = "[General]`r`nName=GLCRY METER`r`n`r`n[Video]`r`nBaseCX=1920`r`nBaseCY=1080`r`nOutputCX=1920`r`nOutputCY=1080`r`nFPSType=1`r`nFPSInt=240`r`nScaleType=bicubic`r`n"
    [IO.File]::WriteAllText((Join-Path $prof 'basic.ini'), $basic, $enc)
    $scene = @'
{
  "name": "GLCRY METER",
  "current_scene": "GLCRY METER",
  "current_program_scene": "GLCRY METER",
  "scene_order": [ { "name": "GLCRY METER" } ],
  "sources": [
    {
      "id": "scene", "versioned_id": "scene", "name": "GLCRY METER", "enabled": true, "flags": 0,
      "mixers": 0, "volume": 1.0, "muted": false,
      "settings": {
        "id_counter": 1, "custom_size": false,
        "items": [ {
          "name": "NBA 2K21", "id": 1, "visible": true, "locked": false, "rot": 0.0,
          "pos": { "x": 0.0, "y": 0.0 }, "scale": { "x": 1.0, "y": 1.0 }, "align": 5,
          "bounds_type": 2, "bounds_align": 0, "bounds": { "x": 1920.0, "y": 1080.0 },
          "crop_left": 0, "crop_top": 0, "crop_right": 0, "crop_bottom": 0
        } ]
      }
    },
    {
      "id": "game_capture", "versioned_id": "game_capture", "name": "NBA 2K21", "enabled": true, "flags": 0,
      "mixers": 0, "volume": 1.0, "muted": false,
      "settings": { "capture_mode": "window", "window": "NBA 2K21::NBA2K21.exe", "priority": 2,
                    "capture_cursor": false, "allow_transparency": false }
    }
  ],
  "groups": [], "transitions": [], "current_transition": "Fade", "transition_duration": 300,
  "quick_transitions": [], "saved_projectors": [], "preview_locked": false, "scaling_enabled": false,
  "modules": {}
}
'@
    [IO.File]::WriteAllText((Join-Path $scenes 'GLCRY_METER.json'), $scene, $enc)
    return $true
}

Clear-Host
Write-Host ''
Write-Host '   ==================================================' -ForegroundColor DarkGray
Write-Host '    GLCRY ' -ForegroundColor White -NoNewline; Write-Host 'METER' -ForegroundColor Yellow -NoNewline; Write-Host "   setup  v$Version" -ForegroundColor DarkGray
Write-Host '   ==================================================' -ForegroundColor DarkGray
Write-Host ''
Write-Host '   Everything GLCRY METER needs is downloaded and set up for you.' -ForegroundColor Gray
Write-Host '   This takes about 5 minutes. Please keep this window open.' -ForegroundColor Gray
$NeedRestart = $false

try {
    New-Item -ItemType Directory -Force -Path $Root, $Tmp | Out-Null

    Step 1 'Python (the engine GLCRY METER runs on)'
    if (-not (Test-Path (Join-Path $Py 'pythonw.exe'))) {
        Note 'Installing (this is the longest step)...'
        InstallPython $Py $Tmp
        Ok 'Installed'
    } else { Ok 'Already installed' }

    Step 2 'GLCRY METER'
    $zip = Join-Path $Tmp 'app.zip'
    [IO.File]::WriteAllBytes($zip, [Convert]::FromBase64String($Payload))
    $unz = Join-Path $Tmp 'app'
    if (Test-Path $unz) { Remove-Item -Recurse -Force $unz }
    Expand-Archive -Path $zip -DestinationPath $unz -Force
    New-Item -ItemType Directory -Force -Path $App | Out-Null
    $rc = Native robocopy (Join-Path $unz 'GLCRY_METER') $App /E /R:2 /W:1 /NFL /NDL /NJH /NJS /NP
    if ($rc -ge 8) { throw "Couldn't copy GLCRY METER's files (is GLCRY METER still open? close it and run setup again)." }
    Ok "Version $Version"

    Step 3 'Components (video, controller and window parts)'
    $python = Join-Path $Py 'python.exe'
    $null = Native $python -m pip install --disable-pip-version-check -q --no-warn-script-location --upgrade pip
    $rc = Native $python -m pip install --disable-pip-version-check -q --no-warn-script-location -r (Join-Path $App 'requirements.txt')
    if ($rc -ne 0) { throw 'Component install failed - check your internet connection and run setup again.' }
    Ok 'Installed'

    Step 4 'Virtual controller driver (ViGEmBus)'
    if (-not (Get-Service ViGEmBus -ErrorAction SilentlyContinue)) {
        $f = Join-Path $Tmp 'ViGEmBus_setup.exe'
        Download (LatestAsset 'nefarius/ViGEmBus' 'x64.*\.exe$') $f
        $null = RunInstaller $f
        Ok 'Installed'
    } else { Ok 'Already installed' }

    Step 5 'Controller hider (HidHide) - stops the game seeing your controller twice'
    if (-not (Get-Service HidHide -ErrorAction SilentlyContinue)) {
        $f = Join-Path $Tmp 'HidHide_setup.exe'
        Download (LatestAsset 'nefarius/HidHide' 'x64.*\.exe$') $f
        $null = RunInstaller $f
        $NeedRestart = $true      # its driver only attaches to controllers after a restart
        Ok 'Installed'
    } else { Ok 'Already installed' }
    $cli = Get-ChildItem -Path "$env:ProgramFiles\Nefarius Software Solutions" -Filter HidHideCLI.exe -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($cli) {
        $null = Native $cli.FullName --app-reg (Join-Path $Py 'pythonw.exe')
        $null = Native $cli.FullName --app-reg (Join-Path $Py 'python.exe')
        Note 'GLCRY METER is allowed to see hidden controllers'
    }

    Step 6 'OBS Studio (sends the game video to GLCRY METER)'
    try {
        if (-not (Test-Path $ObsExe)) {
            Note 'Installing OBS Studio...'
            InstallObs $Tmp
        }
        if (Test-Path $ObsExe) {
            Ok 'OBS Studio is installed'
            if (ConfigureObs) { Ok 'Set up for GLCRY METER: 1920x1080, 240 fps, NBA 2K21 game capture' }
            else { Note 'You already use OBS, so your scenes were left as they are' }
            Note 'GLCRY METER opens OBS and starts its Virtual Camera for you'
        } else { Note "OBS didn't install - get it from obsproject.com (the rest of setup is fine)" }
    } catch { Note "OBS couldn't be installed automatically - get it from obsproject.com" }

    Step 7 'Shortcuts'
    $ws = New-Object -ComObject WScript.Shell
    $targets = @((Join-Path ([Environment]::GetFolderPath('Desktop')) 'GLCRY METER.lnk'),
                 (Join-Path ([Environment]::GetFolderPath('Programs')) 'GLCRY METER.lnk'))
    foreach ($l in $targets) {
        $s = $ws.CreateShortcut($l)
        $s.TargetPath = Join-Path $Py 'pythonw.exe'
        $s.Arguments = "`"$(Join-Path $App 'GlcryMeter_Launcher.pyw')`""
        $s.WorkingDirectory = $App
        $s.IconLocation = Join-Path $App 'glcry\icon.ico'
        $s.Description = 'GLCRY METER'
        $s.Save()
    }
    Ok 'GLCRY METER is on your desktop and in the Start menu'

    Write-Host ''
    Write-Host '   ==================================================' -ForegroundColor DarkGray
    Write-Host '    All done!' -ForegroundColor Green
    Write-Host '   ==================================================' -ForegroundColor DarkGray
    Write-Host '   GLCRY METER is opening now. Paste your key into it.' -ForegroundColor Gray
    Write-Host '   Next time, use the GLCRY METER icon on your desktop.' -ForegroundColor Gray
    if ($NeedRestart) {
        Write-Host ''
        Write-Host '   IMPORTANT: restart your PC before your first game.' -ForegroundColor Yellow
        Write-Host '   The controller hider only starts working after a restart.' -ForegroundColor Yellow
        Write-Host '   (You can paste your key first - it stays saved.)' -ForegroundColor Gray
    }
    Start-Process (Join-Path $Py 'pythonw.exe') -ArgumentList "`"$(Join-Path $App 'GlcryMeter_Launcher.pyw')`"" -WorkingDirectory $App
    if ($NeedRestart) { Write-Host ''; Read-Host '   Press Enter to close this window' } else { Start-Sleep 6 }
}
catch {
    Write-Host ''
    Write-Host "   Setup couldn't finish: $($_.Exception.Message)" -ForegroundColor Red
    Write-Host '   Check your internet connection and run setup again.' -ForegroundColor Gray
    Write-Host ''
    Read-Host '   Press Enter to close'
}
