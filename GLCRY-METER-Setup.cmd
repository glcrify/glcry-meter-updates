powershell -NoProfile -Command "Start-Process -FilePath $env:GLCRY_SETUP -Verb RunAs"
exit /b
:admin
powershell -NoProfile -ExecutionPolicy Bypass -Command "iex ([IO.File]::ReadAllText($env:GLCRY_SETUP))"
exit /b
#>

